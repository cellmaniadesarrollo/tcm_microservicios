# Dockerfile.dev - Gateway (versión mejorada)
FROM node:20-alpine

# Necesario para chokidar (watching en Docker)
RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package*.json ./

# ✅ Instalar dependencias con legacy-peer-deps para evitar conflictos
RUN npm install --legacy-peer-deps

# copiar el código FUERA de aquí, porque usas volumes
COPY . .

EXPOSE 3000

CMD ["npm", "run", "start"]